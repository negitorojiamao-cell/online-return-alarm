<Window x:Class="OnlineReturnAlarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONLINE RETURN"
        Width="1120" Height="780" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B1019" Foreground="#F1F5FB"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#141D2B"/>
            <Setter Property="BorderBrush" Value="#263449"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7FAFF"/>
            <Setter Property="Background" Value="#1769E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#263449"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE5F1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F7FC"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ONLINE RETURN" FontSize="25" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="接続復帰を見逃さない Windows アラーム" FontSize="13" Foreground="#8494AA" Margin="1,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#192638" BorderBrush="#2C405A" BorderThickness="1" CornerRadius="14" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8494AA" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock x:Name="StatusBadge" Text="停止中" FontSize="12" FontWeight="SemiBold" Foreground="#DCE5F1"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*"/>
                <ColumnDefinition Width="0.88*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="接続状態" Foreground="#8FA1B8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ConnectionTitle" Text="監視を開始してください" FontSize="25" FontWeight="Bold" Margin="0,12,0,5"/>
                        <TextBlock x:Name="ConnectionDetail" Text="開始すると約5秒間隔でインターネット接続を確認します。" Foreground="#9AABC0" FontSize="13" TextWrapping="Wrap"/>
                        <Border x:Name="AlertPanel" Background="#202C3D" BorderBrush="#344A65" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AlertHeadline" Text="待機状態" FontWeight="Bold" FontSize="15"/>
                                <TextBlock x:Name="AlertDescription" Text="オフラインからオンラインへの変化を検知すると、ここに警告を表示します。" Foreground="#A9B8CA" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="StartButton" Style="{StaticResource ActionButton}" Content="監視を開始" Click="StartMonitoring_Click"/>
                            <Button x:Name="StopButton" Style="{StaticResource QuietButton}" Content="監視を停止" Click="StopMonitoring_Click" IsEnabled="False"/>
                            <Button Style="{StaticResource QuietButton}" Content="アラームをテスト" Click="TestAlarm_Click"/>
                            <Button Style="{StaticResource QuietButton}" x:Name="StopAlarmButton" Content="アラーム停止" Click="StopAlarm_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="イベント履歴" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="#B8C6D8"
                                 FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MaxHeight="170">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="音量・アラーム" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="SoundCheck" Content="接続復帰時にアラーム音を再生" IsChecked="True"/>
                        <CheckBox x:Name="RaiseVolumeCheck" Content="Windowsのマスター音量を変更する（明示的に有効化）" IsChecked="False" Checked="RaiseVolume_Changed" Unchecked="RaiseVolume_Changed"/>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="復帰時の音量" Foreground="#A9B8CA" FontSize="12" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="VolumePercentLabel" Text="70%" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Slider x:Name="VolumeSlider" Minimum="30" Maximum="100" Value="70" TickFrequency="10"
                                IsSnapToTickEnabled="False" Margin="0,8,0,5" IsEnabled="False" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock Text="音量100%は聴覚に危険な場合があります。初期状態では音量変更は無効です。音量変更を有効にした場合も、アラーム停止時に変更前の音量へ戻します。"
                                   Foreground="#D8B17A" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ウィンドウ表示" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="BringToFrontCheck" Content="復帰時にアプリを前面へ表示" IsChecked="True"/>
                        <CheckBox x:Name="AlwaysOnTopCheck" Content="常に最前面に表示" IsChecked="False" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"/>
                        <CheckBox x:Name="FlashCheck" Content="復帰時に警告表示を点滅させる" IsChecked="True"/>
                        <TextBlock Text="Windowsの保護画面・ロック画面・UAC画面を突破することはできません。ほかのアプリ上への表示もWindowsのフォーカス制御に従います。"
                                   Foreground="#91A2B7" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="動作仕様" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="・約5秒ごとに外部HTTPS接続を確認&#10;・連続2回の成功／失敗で状態を確定&#10;・オフライン→オンラインの変化だけを通知&#10;・初回起動時、すでにオンラインなら鳴動しない"
                                   Foreground="#A9B8CA" FontSize="12" LineHeight="22"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="ONLINE RETURN  •  Windows 10 / 11  •  設定はこのPC内に保存"
                   Foreground="#61738B" FontSize="11" Margin="2,18,0,0"/>
    </Grid>
</Window>
